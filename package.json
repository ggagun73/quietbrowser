{
  "name": "quiet-browse",
  "version": "0.1.0",
  "description": "A personal macOS browser for intentional web use.",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --enable-logging",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/renderer.js && node --check scripts/start.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "42.11.9",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.quietbrowse.app",
    "productName": "Quiet Browse",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
